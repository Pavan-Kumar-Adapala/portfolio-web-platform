# ── Frontend ──────────────────────────────────────────
# Replace with your EC2 public IP or custom domain
RAG_API_SERVER_URL=http://YOUR_EC2_IP:8000

# ── Backend CORS ──────────────────────────────────────
# Must match wherever frontend is served from
CORS_ORIGINS=http://YOUR_EC2_IP,http://YOUR_DOMAIN.com

# Model names defined once here — used by both init container and backend
LLM_MODEL=llama3.1:latest
EMBEDDINGS_MODEL=qwen3-embedding:4b

# ── RAG config overrides (optional) ──────────────────
# Leave blank to use config.yaml defaults
# LLM_MODEL=llama3.1:latest
# EMBEDDINGS_MODEL=qwen3-embedding:4b
# PDF_DIR=
# CHROMA_DB_DIR=
# TOP_K=
# CHUNK_SIZE=
# CHUNK_OVERLAP=